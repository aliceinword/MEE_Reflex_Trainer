# Copy this file to ".streamlit/secrets.toml" (local) or paste its contents into
# the Streamlit Community Cloud "Secrets" box (Manage app -> Settings -> Secrets).
#
# IMPORTANT: never commit the real secrets.toml. It is git-ignored.
#
# If the [auth] section is absent or has no users, the app runs WITHOUT a login
# (handy for local use). Add users here to turn the login gate on.
#
# Generate each user's block with:
#     python make_user.py <username> "<Display Name>" "<password>"

[auth.users.owner]
name = "Owner"
# bcrypt hash of the owner's password (replace with output from make_user.py)
password = "$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH_FROM_make_user_py"

# Add more users the same way. To revoke someone, delete their block.
# [auth.users.alice]
# name = "Alice"
# password = "$2b$12$..."
