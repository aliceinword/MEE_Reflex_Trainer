# Copy this file to ".streamlit/secrets.toml" (local) or paste its contents into
# the Streamlit Community Cloud "Secrets" box (Manage app -> Settings -> Secrets).
#
# IMPORTANT: never commit the real secrets.toml. It is git-ignored.
#
# This [auth.admin] block seeds your admin account on startup (so it always
# exists, even if the database resets). Once an admin exists, the app requires
# sign-in, and the admin can create/remove other users from the in-app
# "Manage Users" page -- no need to edit this file for each person.
#
# Generate the bcrypt hash with:
#     python make_user.py olesialek "Olesia" "your-password"
# (use the printed hash below; the password itself is never stored)

[auth.admin]
username = "olesialek"
email = "olesialek@gmail.com"
name = "Olesia"
password = "$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH_FROM_make_user_py"

# If this whole [auth] section is absent, the app runs WITHOUT a login
# (handy for local use).
